# ---------------------------------------------------------------------------
# SignalScope configuration
#
# Copy to .env and fill in. Everything except NEXT_PUBLIC_APP_URL, DATABASE_URL,
# AUTH_SECRET and one AI provider key is optional — unset features stay disabled.
# SignalScope is host-agnostic: it needs a PostgreSQL URL and a place to run
# Node 22, nothing cloud-specific.
# ---------------------------------------------------------------------------

# Public app URL (local dev default; set to your deployment URL in production)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (local dev: standard connection string; self-hosted: your Postgres URL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/signalscope?schema=public

# Max Postgres connections per app instance (default 5). Raise on larger servers.
# DATABASE_POOL_MAX=5

# Optional second database. The harvester mirrors writes here, and scripts/extract.py
# uses it as the pg_restore target. Must be a local host.
# DATABASE_URL_DEV=postgresql://postgres:postgres@host.docker.internal:5432/signalscope?schema=public

# Auth.js secret (generate with: openssl rand -base64 32)
AUTH_SECRET=your-auth-secret-here

# Canonical base URL behind a reverse proxy — pins Auth.js callbacks and blocks
# host-header injection. Optional; falls back to the request host.
# AUTH_URL=https://your-host.example

# Build identifier shown in the dashboard footer. Cloud Run, Render, Railway,
# Vercel, Fly.io and Heroku are detected automatically; set this on other hosts.
# APP_REVISION=git-sha-or-build-number

# AI providers
OPENAI_API_KEY=sk-your-openai-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# Primary AI provider: "openai" or "anthropic"
AI_PRIMARY_PROVIDER=openai

# Optional per-call-point AI provider overrides ("openai" or "anthropic")
# AI_PROVIDER_SCORING=anthropic
# AI_PROVIDER_PND=anthropic
# AI_PROVIDER_REPORT=anthropic

# Resend (optional outbound notifications — skipped if either var is unset)
# RESEND_API_KEY=re_your-resend-key
# EMAIL_FROM=   # verified From header for your mail provider (no default in code)

# Remote harvester (slim mode — fetches locally, processes on your web app; optional)
# HARVEST_API_KEY=your-harvest-api-key
# HARVEST_ENDPOINT_URL=http://localhost:3000/api/harvest/ingest
# Or point at your deployed web app: HARVEST_ENDPOINT_URL=https://your-app.example/api/harvest/ingest

# Shared secret for the scheduled-job endpoints (snapshots, reports, alerts,
# tweets, broker sync). Any scheduler works — cron, systemd timers, Kubernetes
# CronJobs, GitHub Actions, or a managed cloud scheduler.
# SNAPSHOT_API_KEY=your-snapshot-api-key

# Skip harvest runs when the macro regime looks unfavourable ("true" to enable)
# REGIME_SKIP_ENABLED=false

# SEO — search engine verification (optional; omit if verified via DNS or HTML file)
# GOOGLE_SITE_VERIFICATION=your-google-html-tag-content-value
# BING_SITE_VERIFICATION=your-bing-msvalidate-content-value

# x402 payment protocol — anonymous pay-per-call for AI agents (USDC on Base; disabled if absent)
# X402_WALLET_ADDRESS=0xYOUR_WALLET_ADDRESS

# Stripe subscriptions (optional — Pro checkout / portal / webhooks)
# STRIPE_SECRET_KEY=sk_test_your-stripe-secret
# STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable
# STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
# STRIPE_PRICE_MONTHLY=price_your-monthly-price-id
# STRIPE_PRICE_YEARLY=price_your-yearly-price-id

# X/Twitter harvest (optional — recent search for signal collection; skipped if unset)
# X_BEARER_TOKEN=your-x-bearer-token
# X_MAX_TWEETS_PER_RUN=300
# X_MAX_PAGES=3

# Broker paper trading (optional). BROKER_PROVIDER defaults to "alpaca".
# BROKER_PROVIDER=alpaca
# ALPACA_API_KEY=your-alpaca-api-key
# ALPACA_SECRET_KEY=your-alpaca-secret-key
# ALPACA_PAPER=true

# Analytics (optional — omit to disable GTM / GA4 entirely)
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXXX
# NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX
# GA4_API_SECRET=your-ga4-measurement-protocol-secret

# Local admin seed (npm run db:seed). Defaults to dev@localhost / password123
# and refuses non-local database hosts unless SEED_ALLOW_REMOTE=1.
# SEED_ADMIN_EMAIL=dev@localhost
# SEED_ADMIN_PASSWORD=change-me

# Google Cloud SQL only — used by scripts/extract.py and scripts/pg_perf.py when
# you pass --cloud-sql-proxy. Not needed for any other host.
# GCP_PROJECT_ID=your-gcp-project
# GCP_REGION=us-central1
# GCP_INSTANCE_NAME=your-cloud-sql-instance
# GCP_DB_USER=signalscope
# GCP_DB_NAME=signalscope
# DB_PASSWORD=your-cloud-sql-password
