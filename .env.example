# Public app URL (local dev default; set to your deployment URL in production)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (local dev: standard connection string; self-hosted: your Postgres URL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/signalscope?schema=public

# Optional: scripts/extract.py uses DATABASE_URL_DEV for pg_restore if set; otherwise uses DATABASE_URL when local (localhost / host.docker.internal)
# DATABASE_URL_DEV=postgresql://postgres:postgres@host.docker.internal:5432/signalscope?schema=public

# Auth.js secret (generate with: openssl rand -base64 32)
AUTH_SECRET=your-auth-secret-here

# AI providers
OPENAI_API_KEY=sk-your-openai-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# Primary AI provider: "openai" or "anthropic"
AI_PRIMARY_PROVIDER=openai

# Optional per-call-point AI provider overrides ("openai" or "anthropic")
# AI_PROVIDER_SCORING=anthropic
# AI_PROVIDER_PND=anthropic
# AI_PROVIDER_REPORT=anthropic

# Resend (optional outbound notifications — skipped if either var is unset)
# RESEND_API_KEY=re_your-resend-key
# EMAIL_FROM=   # verified From header for your mail provider (no default in code)


# Remote harvester (slim mode — fetches locally, processes on your web app; optional)
# HARVEST_API_KEY=your-harvest-api-key
# HARVEST_ENDPOINT_URL=http://localhost:3000/api/harvest/ingest
# Or point at your deployed web app: HARVEST_ENDPOINT_URL=https://your-app.example/api/harvest/ingest

# Snapshots (scheduled job → your web app; optional — only needed when collecting price snapshots)
# SNAPSHOT_API_KEY=your-snapshot-api-key

# SEO — search engine verification (optional; omit if verified via DNS or HTML file)
# GOOGLE_SITE_VERIFICATION=your-google-html-tag-content-value
# BING_SITE_VERIFICATION=your-bing-msvalidate-content-value

# x402 payment protocol — anonymous pay-per-call for AI agents (USDC on Base; disabled if absent)
# X402_WALLET_ADDRESS=0xYOUR_WALLET_ADDRESS

# Apple In-App Purchase (StoreKit 2)
# APPLE_ENV=Sandbox                # "Sandbox" or "Production"
# APPLE_APP_APPLE_ID=               # numeric App Store ID; from App Store Connect
# APPLE_ROOT_CERTS_DIR=./certs/apple
#   Place the four Apple root certificate .cer files here:
#     AppleIncRootCertificate.cer
#     AppleRootCA-G2.cer
#     AppleRootCA-G3.cer
#     AppleComputerRootCertificate.cer
#   Source: https://www.apple.com/certificateauthority/
