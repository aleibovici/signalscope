FROM node:20-alpine

# Install Cloud SQL Auth Proxy
RUN wget -q https://storage.googleapis.com/cloud-sql-connectors/cloud-sql-proxy/v2.14.3/cloud-sql-proxy.linux.arm64 -O /usr/local/bin/cloud-sql-proxy \
  && chmod +x /usr/local/bin/cloud-sql-proxy

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npx prisma generate

COPY scripts/entrypoint-harvester.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
