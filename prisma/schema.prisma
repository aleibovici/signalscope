generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  name         String?
  passwordHash String?
  role         String         @default("user")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  positions    UserPosition[]
}

model Scan {
  id               String            @id @default(cuid())
  status           ScanStatus        @default(RUNNING)
  startedAt        DateTime          @default(now())
  completedAt      DateTime?
  signalCount      Int               @default(0)
  validatedCount   Int               @default(0)
  filteredCount    Int               @default(0)
  aiCost           Float             @default(0)
  error            String?
  signals          Signal[]
  validatedTickers ValidatedTicker[]

  @@index([startedAt])
  @@index([status])
}

enum ScanStatus {
  RUNNING
  COMPLETED
  FAILED
}

model Signal {
  id            String       @id @default(cuid())
  scanId        String
  scan          Scan         @relation(fields: [scanId], references: [id], onDelete: Cascade)
  symbol        String
  source        SignalSource
  title         String?
  body          String?      @db.Text
  url           String?
  author        String?
  authorAge     Int?
  authorKarma   Int?
  upvotes       Int?
  commentCount  Int?
  velocityScore Float        @default(0)
  sentiment     String?
  pndFlagged    Boolean      @default(false)
  pndFlags      String[]
  pndScore      Int          @default(0)
  createdAt     DateTime     @default(now())

  @@index([scanId, symbol])
  @@index([symbol])
}

enum SignalSource {
  REDDIT
  STOCKTWITS
  SEC_INSIDER
  OPTIONS_FLOW
  VOLUME_SPIKE
  TWITTER
}

model ValidatedTicker {
  id             String      @id @default(cuid())
  scanId         String
  scan           Scan        @relation(fields: [scanId], references: [id], onDelete: Cascade)
  symbol         String
  price          Float?
  marketCap      Float?
  shortFloat     Float?
  catalyst       String?     @db.Text
  risks          String?     @db.Text
  recommendation String?
  report         String?     @db.Text
  aiScore        Int         @default(0)
  stage          TickerStage @default(EARLY)
  signalCount    Int         @default(0)
  sourceCount    Int         @default(0)
  avgSentiment   Float?
  signalType       String?     // insider_buy | options_flow | multi_source | reddit_velocity
  fiftyTwoWkRange  String?     // e.g. "12.50 - 45.00"
  exchange         String?     // NYSE, NASDAQ, OTC, etc.
  firstSeenDaysAgo Int?        // null = truly novel, 0 = first seen today, N = days ago
  priorAppearances Int         @default(0) // count of previous ValidatedTicker rows in 30d window
  createdAt        DateTime    @default(now())
  performance      TickerPerformance?

  @@unique([scanId, symbol])
  @@index([symbol])
  @@index([stage])
  @@index([createdAt])
}

model TickerPerformance {
  id                String          @id @default(cuid())
  validatedTickerId String          @unique
  validatedTicker   ValidatedTicker @relation(fields: [validatedTickerId], references: [id], onDelete: Cascade)
  symbol            String
  detectionPrice    Float

  price1d           Float?
  price3d           Float?
  price7d           Float?
  price30d          Float?
  return1d          Float?
  return3d          Float?
  return7d          Float?
  return30d         Float?
  snapped1dAt       DateTime?
  snapped3dAt       DateTime?
  snapped7dAt       DateTime?
  snapped30dAt      DateTime?

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([symbol])
  @@index([createdAt])
}

enum TickerStage {
  EARLY
  FORMING
  CONFIRMED
  FILTERED
}

model UserPosition {
  id         String         @id @default(cuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol     String
  entryPrice Float
  shares     Float?
  notes      String?
  status     PositionStatus @default(OPEN)
  openedAt   DateTime       @default(now())
  closedAt   DateTime?
  closePrice Float?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([userId, status])
  @@index([symbol])
}

enum PositionStatus {
  OPEN
  CLOSED
}
