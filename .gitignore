# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# local editor / IDE config
.claude/
.cursor/
.vscode/
.mcp.json

# service account keys
sa-key.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# python
__pycache__/
.venv/

# scripts
scripts/output/

# Git worktrees
.worktrees/

# harvester logs
/logs/

# CI and Apple root certs (maintainer-local; not shipped in OSS tree)
.github/
/certs/

