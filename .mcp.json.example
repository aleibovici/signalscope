{
  "$comment": "Copy to .mcp.json locally. Set stitch headers.X-Goog-Api-Key to your Stitch API key (leave empty or omit the header if unused).",
  "mcpServers": {
    "cloudflare": {
      "command": "npx",
      "args": ["mcp-remote", "https://mcp.cloudflare.com/mcp"]
    },
    "chrome-devtools": {
      "command": "npx",
      "args": ["chrome-devtools-mcp@latest"]
    },
    "stitch": {
      "type": "http",
      "url": "https://stitch.googleapis.com/mcp",
      "headers": {
        "X-Goog-Api-Key": ""
      }
    }
  }
}
